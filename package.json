{
  "name": "souk",
  "version": "1.0.7",
  "main": "server.ts",
  "repository": "",
  "license": "MIT",
  "dependencies": {
    "@types/redis": "4.0.10",
    "@types/uuid": "8.3.4",
    "africastalking": "0.7.9",
    "amqplib": "0.10.3",
    "axios": "1.6.2",
    "bullmq": "5.61.0",
    "cloudinary": "1.41.3",
    "cors": "^2.8.5",
    "crypto": "1.0.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "8.5.1",
    "express-validator": "^6.14.2",
    "firebase-admin": "12.7.0",
    "helmet": "8.1.0",
    "http-errors": "2.0.0",
    "jsonwebtoken": "9.0.3",
    "libphonenumber-js": "1.12.39",
    "lint-staged": "13.1.0",
    "logger": "0.0.1",
    "morgan": "1.10.0",
    "multer": "2.1.1",
    "multer-storage-cloudinary": "4.0.0",
    "node-cron": "4.2.1",
    "nodemon": "3.0.1",
    "pg": "8.11.3",
    "redis": "5.8.3",
    "reflect-metadata": "0.1.13",
    "sequelize": "6.33.0",
    "sequelize-cli": "6.6.1",
    "sequelize-typescript": "2.1.6",
    "sharp": "0.34.5",
    "socket.io": "4.8.3",
    "uuid": "8.3.2",
    "winston": "3.10.0",
    "zod": "3.22.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm install && npm run build:compile",
    "build:qa": "npm install && npm run build:clean && npm run build:compile && rm -rf src",
    "build:clean": "npm run clean",
    "build:compile": "tsc",
    "clean": "rm -rf build",
    "deploy:prepare": "npm run sequelize:migrate && npm run sequelize:seed:all",
    "sequelize:init": "npx sequelize init",
    "sequelize:migrate": "ts-node ./node_modules/sequelize-cli/lib/sequelize db:migrate",
    "sequelize:migrate:undo": "ts-node ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "sequelize:migrate:undo:all": "ts-node ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo:all",
    "sequelize:seed:generate": "read -p 'Enter seed name: ' seedName && sequelize seed:generate --name $seedName",
    "dev": "nodemon --exec ts-node src/server.ts",
    "lint": "eslint --ignore-path .eslintignore \"src/**/*.ts\" --fix",
    "lint:check": "eslint --ignore-path .eslintignore \"src/**/*.ts\"",
    "prettier": "prettier --write \"src/**/*.ts\"",
    "prettier:check": "prettier --check \"src/**/*.ts\"",
    "start": "node build/src/server.js",
    "test": "jest --watch --runInBand"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "eslint --cache --fix",
    "src/**/*.{js,jsx,ts,tsx,css,scss,md}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "17.4.4",
    "@commitlint/config-conventional": "17.4.4",
    "@types/amqplib": "0.10.1",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.15",
    "@types/http-errors": "2.0.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.5",
    "@types/multer": "2.1.0",
    "@types/swagger-jsdoc": "6.0.1",
    "@types/swagger-ui-express": "4.1.3",
    "@types/winston": "2.4.4",
    "@typescript-eslint/eslint-plugin": "5.48.2",
    "@typescript-eslint/parser": "5.48.2",
    "eslint": "8.32.0",
    "eslint-config-prettier": "8.6.0",
    "eslint-config-standard": "17.0.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-promise": "6.1.1",
    "jest": "^29.3.1",
    "prettier": "2.8.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.9.4"
  }
}
